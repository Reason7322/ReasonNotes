<resources>
    <style name="ReasonNotesTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">#DCAF48</item>
        <item name="android:statusBarColor">#15171C</item>
        <item name="android:navigationBarColor">#15171C</item>
